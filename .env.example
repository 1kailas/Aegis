# Aegis secrets environment — copy to .env and fill in values.
# NEVER commit the real .env file; it is gitignored for a reason.

# Gemini (diagnosis tier 2 - cloud fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_REQ_PER_HOUR=30

# Devin (autonomous repair engineer session creation & PR capture)
DEVIN_API_KEY=
DEVIN_API_URL=https://api.devin.ai/v1

# GitHub (optional for Aegis itself; used to publish repair branches).
GITHUB_TOKEN=
