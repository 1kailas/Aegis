# Aegis secrets environment — copy to .env and fill in values.
# NEVER commit the real .env file; it is gitignored for a reason.

# Dual-Model Division of Labor:
# 1. Software Intelligence Model (Gemini: application code, 5xx outages, exceptions, and Devin PRs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SOFTWARE_MODEL=gemini-2.5-flash
GEMINI_MAX_REQ_PER_HOUR=30

# 2. Hardware / Infrastructure Intelligence Model (local compute saturation, auto-scaling instances, VRAM/thermal)
HARDWARE_MODEL=qwen2.5:1.5b

# Devin (autonomous repair engineer session creation & PR capture)
DEVIN_API_KEY=
DEVIN_API_URL=https://api.devin.ai/v1

# GitHub (optional for Aegis itself; used to publish repair branches).
GITHUB_TOKEN=
